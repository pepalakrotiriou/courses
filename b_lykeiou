    <script>
        function toggleSolution(id, btn) {
            const panel = document.getElementById(id);
            const isOpen = panel.classList.toggle('open');
            if (btn.classList.contains('solution-toggle')) {
                btn.innerHTML = isOpen ? '🙈 Απόκρυψη Λύσης' : btn.getAttribute('data-label') || '👁️ Εμφάνιση Λύσης';
                if (!btn.getAttribute('data-label')) {
                    btn.setAttribute('data-label', btn.innerHTML.replace('🙈 Απόκρυψη Λύσης', '👁️ Εμφάνιση Λύσης'));
                }
            } else {
                btn.innerText = isOpen ? 'Απόκρυψη Λύσης' : 'Δες τη Λύση';
            }
        }

        function copyCode(btn) {
            const pre = btn.closest('.code-wrapper').querySelector('pre');
            const text = pre.innerText;
            navigator.clipboard.writeText(text).then(() => {
                const orig = btn.innerText;
                btn.innerText = '✅ Αντιγράφηκε!';
                setTimeout(() => btn.innerText = orig, 1800);
            });
        }
    </script>
